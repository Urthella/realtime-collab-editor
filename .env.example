# ---- Server ----
PORT=4000

# Used to sign JWTs. A dev default is baked in, but set your own for anything real.
JWT_SECRET=dev-secret-change-me

# SQLite database file (default storage). The directory is created automatically.
# Relative paths resolve against the server/ working directory.
SQLITE_PATH=./data/collab.db

# Optional: switch storage to PostgreSQL by providing a connection string.
# When set, the pg adapter is used instead of SQLite.
# DATABASE_URL=postgres://user:pass@localhost:5432/collab

# Persistence tuning: Yjs document state is saved at most once per debounce
# window while people are typing (plus on last-client-disconnect).
SNAPSHOT_DEBOUNCE_MS=2000
# How many history snapshots to keep per document.
SNAPSHOT_HISTORY_LIMIT=20

# CORS origin of the client dev server.
CLIENT_ORIGIN=http://localhost:5173

# ---- Client (Vite) — defaults shown, only needed if the server moves ----
# VITE_API_URL=http://localhost:4000/api
# VITE_WS_URL=ws://localhost:4000/ws
